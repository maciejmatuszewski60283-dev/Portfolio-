---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
---

<BaseLayout
  title={`Nie znaleziono strony | ${site.name}`}
  description="Strona nie istnieje."
  noindex
>
  <section class="not-found">
    <div class="container not-found__inner">
      <p class="not-found__code" aria-hidden="true">
        404
      </p>
      <h1 class="not-found__title">Ta strona nie istnieje</h1>
      <p class="lead">
        Adres mógł się zmienić albo zawiera literówkę. Wróć na stronę główną lub przejdź od razu do
        kontaktu.
      </p>
      <div class="not-found__actions">
        <a class="btn btn--primary" href="/">
          Strona główna
          <Icon name="arrow-right" />
        </a>
        <a class="btn" href="/#kontakt">
          Kontakt
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-height) + 3rem) 4rem;
  }

  .not-found__inner {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    max-width: 40rem;
  }

  .not-found__code {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(5rem, 20vw, 9rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .not-found__title {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
