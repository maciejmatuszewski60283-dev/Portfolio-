---
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
import { getPublishedProjects } from '@/lib/projects';

const projects = await getPublishedProjects();
---

<section class="section" id="projekty" aria-labelledby="projekty-title">
  <div class="container">
    <SectionHeading id="projekty-title" index="03" eyebrow="Portfolio" title="Wybrane projekty">
      <p>
        Każda realizacja w tym miejscu to prawdziwy projekt, opisany od wyzwania, przez przyjęte
        rozwiązanie, aż po efekt.
      </p>
    </SectionHeading>

    {projects.length > 0 ? (
      <ul role="list" class="projects">
        {projects.map((project, index) => (
          <li data-reveal="up" data-reveal-delay={index % 2}>
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
    ) : (
      <div class="showcase" data-reveal="scale">
        <div class="showcase__content">
          <h3 class="showcase__title">Miejsce na Twój projekt</h3>
          <p class="showcase__text">
            Portfolio rozwijam wyłącznie o realizacje, za którymi stoją prawdziwe potrzeby. Bez
            szablonowych makiet tworzonych na pokaz. Jeśli planujesz stronę internetową, aplikację
            albo nowy interfejs, porozmawiajmy o tym, jak mógłby wyglądać.
          </p>
          <div class="showcase__actions">
            <a class="btn btn--primary" href="#kontakt" data-magnetic>
              Opowiedz o swoim pomyśle
              <Icon name="arrow-right" />
            </a>
            <a class="btn" href="#proces">
              Zobacz, jak pracuję
            </a>
          </div>
        </div>
        <div class="showcase__visual" aria-hidden="true">
          <svg class="sketch" viewBox="0 0 400 280" fill="none">
            <rect class="sketch__path" x="10" y="10" width="380" height="260" rx="10" />
            <path class="sketch__path" d="M10 46h380" />
            <circle class="sketch__dot" cx="30" cy="28" r="4" />
            <circle class="sketch__dot" cx="46" cy="28" r="4" />
            <circle class="sketch__dot" cx="62" cy="28" r="4" />
            <path class="sketch__path sketch__path--2" d="M36 84h190M36 108h140" />
            <rect
              class="sketch__path sketch__path--3"
              x="36"
              y="134"
              width="96"
              height="32"
              rx="16"
            />
            <rect
              class="sketch__path sketch__path--2"
              x="36"
              y="194"
              width="100"
              height="54"
              rx="6"
            />
            <rect
              class="sketch__path sketch__path--3"
              x="150"
              y="194"
              width="100"
              height="54"
              rx="6"
            />
            <rect
              class="sketch__path sketch__path--4"
              x="264"
              y="194"
              width="100"
              height="54"
              rx="6"
            />
            <rect class="sketch__accent" x="262" y="72" width="102" height="94" rx="6" />
            <path class="sketch__cursor" d="M300 132l26 10-11 4-5 11z" />
          </svg>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .projects {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 48rem) {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .showcase {
    display: grid;
    gap: 2.5rem;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .showcase__title {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    letter-spacing: -0.035em;
  }

  .showcase__text {
    max-width: 34rem;
    margin-top: 1rem;
    color: var(--text-muted);
  }

  .showcase__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .sketch {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
  }

  .sketch__path {
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
  }

  .sketch__dot {
    fill: var(--line-strong);
  }

  .sketch__accent {
    fill: var(--accent);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
  }

  .sketch__cursor {
    fill: var(--ink);
    opacity: 0;
  }

  :global(.is-visible) .sketch__path {
    animation: draw 2.4s var(--ease-in-out) forwards;
  }

  :global(.is-visible) .sketch__path--2 {
    animation-delay: 300ms;
  }
  :global(.is-visible) .sketch__path--3 {
    animation-delay: 550ms;
  }
  :global(.is-visible) .sketch__path--4 {
    animation-delay: 800ms;
  }

  :global(.is-visible) .sketch__accent {
    animation: pop 700ms 1.6s var(--ease-out) forwards;
  }

  :global(.is-visible) .sketch__cursor {
    animation: cursor 5s 2.2s var(--ease-in-out) infinite;
  }

  :global(html:not(.reveal-ready)) .sketch__path {
    stroke-dashoffset: 0;
  }

  :global(html:not(.reveal-ready)) .sketch__accent {
    transform: none;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pop {
    60% {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes cursor {
    0% {
      opacity: 0;
      transform: translate(60px, 80px);
    }
    20%,
    70% {
      opacity: 1;
      transform: translate(0, 0);
    }
    100% {
      opacity: 0;
      transform: translate(-40px, 40px);
    }
  }

  @media (min-width: 56rem) {
    .showcase {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 4rem;
    }
  }
</style>
