---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { activeSocials, navigation, site } from '@/config/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo />
        <p class="footer__tagline">
          {site.rolePl}. Projektowanie i tworzenie stron internetowych, aplikacji webowych i
          interfejsów w Poznaniu.
        </p>
      </div>

      <nav class="footer__nav" aria-label="Nawigacja w stopce">
        <p class="footer__heading">Nawigacja</p>
        <ul role="list">
          {navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer__nav">
        <p class="footer__heading">Informacje</p>
        <ul role="list">
          <li>
            <a href="/#faq">FAQ</a>
          </li>
          <li>
            <a href="/polityka-prywatnosci/">Polityka prywatności</a>
          </li>
          {activeSocials.map((social) => (
            <li>
              <a href={social.url} target="_blank" rel="noopener noreferrer me">
                {social.label}
                <span class="visually-hidden">(otwiera się w nowej karcie)</span>
              </a>
            </li>
          ))}
          {site.discordUrl && (
            <li>
              <a href={site.discordUrl} target="_blank" rel="noopener noreferrer">
                Discord
                <span class="visually-hidden">(otwiera się w nowej karcie)</span>
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <p class="footer__wordmark" aria-hidden="true" data-reveal="up">
      {site.name.split('').map((char, index) => (
        <span class="footer__char" data-i={index % 8}>
          {char === ' ' ? ' ' : char}
        </span>
      ))}
    </p>

    <div class="footer__bottom">
      <p>
        © {year} {site.name}. Wszelkie prawa zastrzeżone.
      </p>
      <a class="footer__top-link" href="#tresc">
        Do góry
        <Icon name="arrow-up" size={16} />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 4.5rem calc(2rem + env(safe-area-inset-bottom));
    overflow: hidden;
    background: var(--ink);
    color: var(--on-ink);
  }

  .footer__top {
    display: grid;
    gap: 2.5rem;
  }

  .footer__brand :global(.logo__mark) {
    background: var(--on-ink);
    color: var(--ink);
  }

  .footer__tagline {
    max-width: 22rem;
    margin-top: 1.25rem;
    color: rgb(243 241 236 / 0.7);
    font-size: 0.9375rem;
  }

  .footer__heading {
    margin-bottom: 1rem;
    color: rgb(243 241 236 / 0.6);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer__nav ul {
    display: grid;
    gap: 0.35rem;
  }

  .footer__nav a,
  .footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-block: 0.3rem;
    color: rgb(243 241 236 / 0.8);
    font-size: 0.9375rem;
    text-decoration: none;
    transition:
      color var(--duration) var(--ease-out),
      transform 300ms var(--ease-out);
  }

  .footer__nav a:hover {
    color: var(--on-ink);
    transform: translateX(4px);
  }

  .footer__top-link:hover {
    color: var(--on-ink);
  }

  .footer__wordmark {
    display: flex;
    margin-top: 4rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 8.6vw, 8.25rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .footer__char {
    display: inline-block;
    transition:
      transform 500ms var(--ease-out),
      color 300ms var(--ease-out);
  }

  .footer__wordmark:hover .footer__char {
    transform: translateY(-0.08em);
  }

  .footer__char:hover {
    color: var(--accent);
  }

  .footer__wordmark :global(.footer__char[data-i='1']) {
    transition-delay: 20ms;
  }
  .footer__wordmark :global(.footer__char[data-i='2']) {
    transition-delay: 40ms;
  }
  .footer__wordmark :global(.footer__char[data-i='3']) {
    transition-delay: 60ms;
  }
  .footer__wordmark :global(.footer__char[data-i='4']) {
    transition-delay: 80ms;
  }
  .footer__wordmark :global(.footer__char[data-i='5']) {
    transition-delay: 100ms;
  }
  .footer__wordmark :global(.footer__char[data-i='6']) {
    transition-delay: 120ms;
  }
  .footer__wordmark :global(.footer__char[data-i='7']) {
    transition-delay: 140ms;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(243 241 236 / 0.18);
    color: rgb(243 241 236 / 0.65);
    font-size: 0.875rem;
  }

  .footer__top-link :global(svg) {
    transition: transform var(--duration) var(--ease-out);
  }

  .footer__top-link:hover :global(svg) {
    transform: translateY(-3px);
  }

  @media (min-width: 48rem) {
    .footer__top {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
