---
import SectionHeading from './SectionHeading.astro';
import { processSteps } from '@/data/process';
---

<section class="section section--alt" id="proces" aria-labelledby="proces-title">
  <div class="container process">
    <div class="process__intro">
      <SectionHeading
        id="proces-title"
        index="04"
        eyebrow="Proces"
        title="Jak pracuję nad projektem"
      >
        <p>
          Przejrzysty proces to mniej niespodzianek po obu stronach. Każdy etap kończy się
          konkretnym rezultatem, który możesz zobaczyć i skomentować.
        </p>
      </SectionHeading>
    </div>

    <div class="steps-wrap" data-steps>
      <span class="steps__track" aria-hidden="true">
        <span class="steps__fill" data-steps-fill></span>
      </span>
      <ol role="list" class="steps">
        {processSteps.map((step, index) => (
          <li class="step" data-step>
            <span class="step__number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div data-reveal="up">
              <h3 class="step__title">{step.title}</h3>
              <p class="step__text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>('[data-steps]');
  const fill = document.querySelector<HTMLElement>('[data-steps-fill]');
  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];

  if (list && fill && steps.length) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const rect = list.getBoundingClientRect();
      const anchor = window.innerHeight * 0.6;
      const progress = Math.min(Math.max((anchor - rect.top) / rect.height, 0), 1);
      fill.style.transform = `scaleY(${progress})`;
      for (const step of steps) {
        step.classList.toggle('is-reached', step.getBoundingClientRect().top < anchor);
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  .process {
    display: grid;
    gap: 1rem;
  }

  .steps-wrap {
    position: relative;
  }

  .steps {
    position: relative;
    display: grid;
    gap: 2.5rem;
  }

  .steps__track {
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 1.4375rem;
    width: 1px;
    background: var(--line-strong);
  }

  .steps__fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2.875rem minmax(0, 1fr);
    gap: 1.25rem;
  }

  .step__number {
    display: grid;
    place-items: center;
    width: 2.875rem;
    height: 2.875rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg-alt);
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition:
      background-color 400ms var(--ease-out),
      border-color 400ms var(--ease-out),
      color 400ms var(--ease-out),
      transform 500ms var(--ease-out);
  }

  .step.is-reached .step__number {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--on-ink);
    transform: scale(1.06);
  }

  .step__title {
    padding-top: 0.55rem;
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    letter-spacing: -0.025em;
  }

  .step__text {
    max-width: 32rem;
    margin-top: 0.5rem;
    color: var(--text-muted);
  }

  @media (min-width: 64rem) {
    .process {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 5rem;
      align-items: start;
    }

    .process__intro {
      position: sticky;
      top: calc(var(--header-height) + 3rem);
    }

    .steps {
      gap: 3.5rem;
    }
  }
</style>
