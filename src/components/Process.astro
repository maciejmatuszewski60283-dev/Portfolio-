---
import SectionHeading from './SectionHeading.astro';
import { processSteps } from '@/data/process';
---

<section class="section" id="proces" aria-labelledby="proces-title">
  <div class="container">
    <SectionHeading id="proces-title" eyebrow="Proces" title="Jak pracuję nad projektem">
      <p>
        Przejrzysty proces to mniej niespodzianek po obu stronach. Każdy etap kończy się konkretnym
        rezultatem, który możesz zobaczyć i skomentować.
      </p>
    </SectionHeading>

    <ol role="list" class="steps">
      {processSteps.map((step, index) => (
        <li class="step" data-reveal data-reveal-delay={index % 5}>
          <span class="step__number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__text">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    position: relative;
    display: grid;
    gap: 0;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    column-gap: 1.25rem;
    padding-bottom: 2.25rem;
  }

  .step::before {
    content: '';
    position: absolute;
    top: 3.25rem;
    bottom: 0.5rem;
    left: 1.75rem;
    width: 1px;
    background: linear-gradient(var(--border-strong), transparent);
  }

  .step:last-child {
    padding-bottom: 0;
  }

  .step:last-child::before {
    display: none;
  }

  .step__number {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg-raised);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out),
      border-color 300ms var(--ease-out);
  }

  .step:hover .step__number {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .step__title {
    align-self: end;
    padding-top: 0.6rem;
    font-size: 1.25rem;
  }

  .step__text {
    max-width: 34rem;
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9688rem;
  }

  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .step {
      grid-template-columns: 1fr;
      padding-bottom: 0;
    }

    .step::before {
      top: 1.75rem;
      bottom: auto;
      left: 4.5rem;
      right: -1.5rem;
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, var(--border-strong), transparent);
    }

    .step__number {
      grid-row: auto;
      margin-bottom: 1.5rem;
    }

    .step__title {
      padding-top: 0;
    }
  }
</style>
