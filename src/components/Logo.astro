---
import { site } from '@/config/site';
---

<a class="logo" href="/" aria-label={`${site.name}, strona główna`}>
  <span class="logo__mark" aria-hidden="true">
    MM
  </span>
  <span class="logo__text">{site.name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
  }

  .logo__mark {
    display: grid;
    place-items: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--on-ink);
    font-size: 0.75rem;
    letter-spacing: 0;
    transition:
      background-color 300ms var(--ease-out),
      transform 500ms var(--ease-out);
  }

  .logo:hover .logo__mark {
    background: var(--accent);
    transform: rotate(-12deg);
  }
</style>
