---
import Icon from './Icon.astro';
import { site } from '@/config/site';
import { services } from '@/data/services';

const highlights = services.slice(0, 3);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__backdrop" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__glow hero__glow--a"></div>
    <div class="hero__glow hero__glow--b"></div>
  </div>

  <div class="hero__inner container">
    <div class="hero__content">
      <p class="hero__kicker eyebrow">
        {site.role} · {site.city}
      </p>

      <h1 id="hero-title" class="hero__title">
        Tworzę cyfrowe <span class="hero__accent">doświadczenia.</span>
      </h1>

      <p class="hero__lead lead">
        Nazywam się {site.name}. Projektuję i programuję nowoczesne strony internetowe, aplikacje
        webowe i interfejsy — przejrzyste, szybkie i dopracowane w szczegółach. Pracuję w Poznaniu.
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#projekty">
          Zobacz projekty
          <Icon name="arrow-right" />
        </a>
        <a class="btn" href="#kontakt">
          Porozmawiajmy
        </a>
      </div>

      <ul role="list" class="hero__highlights" aria-label="Główne obszary pracy">
        {highlights.map((service) => (
          <li>
            <a href={`#${service.id}`}>
              <Icon name={service.icon} size={18} />
              {service.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="specimen glass">
        <div class="specimen__bar">
          <span></span>
          <span></span>
          <span></span>
          <p>interfejs.tsx</p>
        </div>
        <div class="specimen__body">
          <div class="specimen__type">
            <span class="specimen__glyph">Aa</span>
            <div class="specimen__scale">
              <span class="specimen__line specimen__line--xl"></span>
              <span class="specimen__line specimen__line--lg"></span>
              <span class="specimen__line specimen__line--md"></span>
            </div>
          </div>
          <div class="specimen__swatches">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
          <pre class="specimen__code"><code><span class="t-k">const</span> projekt = {'{'}
  cel: <span class="t-s">'jasny'</span>,
  układ: <span class="t-s">'responsywny'</span>,
  wydajność: <span class="t-n">100</span>,
{'}'};</code></pre>
          <div class="specimen__cta">
            <span class="specimen__button">Wyślij</span>
            <span class="specimen__cursor"></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#o-mnie">
    <span class="visually-hidden">Przewiń do sekcji O mnie</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-height) + 3rem) 5rem;
    overflow: clip;
    isolation: isolate;
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%);
  }

  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    will-change: transform;
  }

  .hero__glow--a {
    top: -10%;
    right: -10%;
    width: min(70vw, 720px);
    aspect-ratio: 1;
    background: radial-gradient(circle, var(--glow-blue), transparent 65%);
    animation: drift-a 22s var(--ease-in-out) infinite alternate;
  }

  .hero__glow--b {
    bottom: -20%;
    left: -15%;
    width: min(80vw, 640px);
    aspect-ratio: 1;
    background: radial-gradient(circle, var(--glow-lime), transparent 65%);
    animation: drift-b 26s var(--ease-in-out) infinite alternate;
  }

  @keyframes drift-a {
    to {
      transform: translate3d(-8%, 10%, 0) scale(1.08);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate3d(10%, -6%, 0) scale(0.94);
    }
  }

  .hero__inner {
    display: grid;
    gap: 4rem;
    align-items: center;
  }

  .hero__content > * {
    animation: rise 900ms var(--ease-out) both;
  }

  .hero__content > :nth-child(2) {
    animation-delay: 80ms;
  }
  .hero__content > :nth-child(3) {
    animation-delay: 180ms;
  }
  .hero__content > :nth-child(4) {
    animation-delay: 260ms;
  }
  .hero__content > :nth-child(5) {
    animation-delay: 340ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .hero__kicker {
    flex-wrap: wrap;
    row-gap: 0.25rem;
  }

  .hero__city::before {
    content: '· ';
  }

  @media (max-width: 29.99rem) {
    .hero__kicker {
      display: grid;
      grid-template-columns: auto 1fr;
    }

    .hero__city {
      grid-column: 2;
    }

    .hero__city::before {
      content: none;
    }
  }

  .hero__title {
    margin-top: 1.5rem;
    font-size: clamp(2.75rem, 9vw, 5.75rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero__accent {
    display: inline-block;
    background: linear-gradient(100deg, var(--text) 0%, var(--accent) 55%, #9ed4ff 110%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero__lead {
    max-width: 36rem;
    margin-top: 1.75rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .hero__highlights a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.35rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .hero__highlights a:hover {
    color: var(--text);
  }

  .hero__highlights :global(svg) {
    color: var(--accent);
  }

  .hero__visual {
    display: none;
  }

  .specimen {
    position: relative;
    overflow: hidden;
    animation: float-in 1100ms 200ms var(--ease-out) both;
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(24px) rotate(-1deg);
    }
  }

  .specimen__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--border);
  }

  .specimen__bar span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
  }

  .specimen__bar p {
    margin-left: auto;
    color: var(--text-subtle);
    font-size: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .specimen__body {
    display: grid;
    gap: 1.5rem;
    padding: 1.75rem;
  }

  .specimen__type {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .specimen__glyph {
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .specimen__scale {
    display: grid;
    flex: 1;
    gap: 0.6rem;
  }

  .specimen__line {
    height: 0.6rem;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.1);
  }

  .specimen__line--xl {
    width: 90%;
    background: rgb(255 255 255 / 0.18);
  }
  .specimen__line--lg {
    width: 70%;
  }
  .specimen__line--md {
    width: 45%;
  }

  .specimen__swatches {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
  }

  .specimen__swatches span {
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .specimen__swatches span:nth-child(1) {
    background: var(--accent);
  }
  .specimen__swatches span:nth-child(2) {
    background: #9ed4ff;
  }
  .specimen__swatches span:nth-child(3) {
    background: var(--text);
  }
  .specimen__swatches span:nth-child(4) {
    background: var(--bg-raised);
  }

  .specimen__code {
    margin: 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgb(0 0 0 / 0.25);
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.7;
    overflow: hidden;
  }

  .t-k {
    color: #9ed4ff;
  }
  .t-s {
    color: var(--accent);
  }
  .t-n {
    color: #ffc58a;
  }

  .specimen__cta {
    position: relative;
    display: flex;
    justify-content: flex-end;
  }

  .specimen__button {
    padding: 0.55rem 1.2rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.8125rem;
    font-weight: 600;
    animation: press 6s 2s var(--ease-out) infinite;
  }

  .specimen__cursor {
    position: absolute;
    right: 1.4rem;
    bottom: -0.9rem;
    width: 1.1rem;
    height: 1.1rem;
    background: var(--text);
    clip-path: polygon(0 0, 100% 62%, 52% 62%, 30% 100%);
    animation: cursor 6s 2s var(--ease-in-out) infinite;
  }

  @keyframes press {
    0%,
    44%,
    54%,
    100% {
      transform: none;
      box-shadow: none;
    }
    48% {
      transform: scale(0.95);
      box-shadow: 0 0 0 6px var(--accent-soft);
    }
  }

  @keyframes cursor {
    0%,
    100% {
      transform: translate(-90px, 40px);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    40%,
    60% {
      transform: translate(0, 0);
      opacity: 1;
    }
    85% {
      opacity: 0;
    }
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    display: none;
    width: 1.5rem;
    height: 3rem;
    translate: -50% 0;
  }

  .hero__scroll-line {
    position: absolute;
    inset: 0 50%;
    width: 1px;
    overflow: hidden;
    background: var(--border);
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: scroll-hint 2.4s var(--ease-in-out) infinite;
  }

  @keyframes scroll-hint {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  @media (min-width: 40rem) {
    .hero__scroll {
      display: block;
    }
  }

  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    }

    .hero__visual {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__glow,
    .specimen__button,
    .specimen__cursor,
    .hero__scroll-line::after {
      animation: none;
    }

    .specimen__cursor {
      opacity: 0;
    }
  }
</style>
