---
import Icon from './Icon.astro';
import { site } from '@/config/site';

const focusAreas = [
  'strony internetowe',
  'aplikacje webowe i PWA',
  'projektowanie UI/UX',
  'interaktywne wizualizacje',
];
const marquee = [
  'Strony internetowe',
  'Aplikacje PWA',
  'Projektowanie UI/UX',
  'Interfejsy',
  'Wizualizacje',
  'Poznań',
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__meta">
      <p class="eyebrow hero__fade">{site.role}</p>
      <p class="hero__clock hero__fade" data-clock hidden>
        {site.city}, <time data-clock-time></time>
      </p>
    </div>

    <h1 id="hero-title" class="hero__title">
      <span class="hero__line">
        <span>Tworzę cyfrowe</span>
      </span>{' '}
      <span class="hero__line">
        <span>
          doświadczenia<em>.</em>
        </span>
      </span>
    </h1>

    <div class="hero__bottom">
      <p class="hero__lead lead hero__fade">
        Nazywam się {site.name}. Projektuję i programuję nowoczesne strony internetowe, aplikacje
        webowe i interfejsy. Stawiam na przejrzystość, szybkość i dopracowane szczegóły. Pracuję w
        Poznaniu.
      </p>

      <div class="hero__side hero__fade">
        <p class="hero__focus">
          <span class="hero__focus-label">Zajmuję się:</span>
          <span class="visually-hidden">{focusAreas.join(', ')}</span>
          <span class="rotator" aria-hidden="true" data-rotator>
            {focusAreas.map((area, index) => (
              <span class:list={['rotator__item', { 'is-active': index === 0 }]}>{area}</span>
            ))}
          </span>
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#projekty" data-magnetic>
            Zobacz projekty
            <Icon name="arrow-right" />
          </a>
          <a class="btn" href="#kontakt" data-magnetic>
            Porozmawiajmy
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <ul class="marquee__group">
          {marquee.map((item) => (
            <li>
              {item}
              <svg class="marquee__star" viewBox="0 0 24 24">
                <path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4" />
              </svg>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<script>
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  const clockTime = document.querySelector<HTMLTimeElement>('[data-clock-time]');

  if (clock && clockTime) {
    const format = new Intl.DateTimeFormat('pl-PL', {
      timeZone: 'Europe/Warsaw',
      hour: '2-digit',
      minute: '2-digit',
    });
    const tick = () => {
      clockTime.textContent = format.format(new Date());
    };
    tick();
    clock.hidden = false;
    window.setInterval(tick, 15_000);
  }

  const rotator = document.querySelector<HTMLElement>('[data-rotator]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (rotator && !reducedMotion) {
    const items = [...rotator.querySelectorAll<HTMLElement>('.rotator__item')];
    let current = 0;

    window.setInterval(() => {
      if (document.hidden) return;
      const previous = items[current];
      current = (current + 1) % items.length;
      previous.classList.remove('is-active');
      previous.classList.add('is-leaving');
      items[current].classList.add('is-active');
      window.setTimeout(() => previous.classList.remove('is-leaving'), 600);
    }, 2600);
  }
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100svh;
    padding-top: calc(var(--header-height) + clamp(2rem, 6vw, 4rem));
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .hero__clock {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .hero__clock[hidden] {
    display: none;
  }

  .hero__title {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    font-size: clamp(2.5rem, 11.5vw, 8rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .hero__line > span {
    display: inline-block;
    animation: line-up 1100ms var(--ease-out) both;
  }

  .hero__line:nth-child(2) > span {
    animation-delay: 120ms;
  }

  .hero__title em {
    color: var(--accent);
    font-style: normal;
    display: inline-block;
    animation: dot-drop 900ms 900ms var(--ease-out) both;
  }

  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes dot-drop {
    from {
      opacity: 0;
      transform: translateY(-0.6em) scale(0.4);
    }
    60% {
      opacity: 1;
      transform: translateY(0.05em) scale(1.15);
    }
  }

  .hero__fade {
    animation: fade-in 900ms 450ms var(--ease-out) both;
  }

  .hero__meta .hero__fade {
    animation-delay: 0ms;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .hero__bottom {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .hero__lead {
    max-width: 34rem;
  }

  .hero__focus {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 1.0625rem;
  }

  .hero__focus-label {
    color: var(--text-muted);
  }

  .rotator {
    display: inline-grid;
    overflow: hidden;
    font-weight: 600;
  }

  .rotator__item {
    grid-area: 1 / 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(100%);
    transition:
      transform 600ms var(--ease-out),
      opacity 600ms var(--ease-out);
  }

  .rotator__item.is-active {
    opacity: 1;
    transform: none;
  }

  .rotator__item.is-leaving {
    transform: translateY(-100%);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .marquee {
    overflow: hidden;
    padding-block: 1.1rem;
    border-top: 1px solid var(--line);
    background: var(--ink);
    color: var(--on-ink);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 32s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__group {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marquee__group li {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .marquee__star {
    width: 0.8em;
    height: 0.8em;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    animation: spin 8s linear infinite;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (min-width: 64rem) {
    .hero__bottom {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: 4rem;
    }

    .hero__side {
      justify-self: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track,
    .marquee__star {
      animation: none;
    }
  }
</style>
