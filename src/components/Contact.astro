---
import ContactForm from './ContactForm.astro';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { activeSocials, site } from '@/config/site';
---

<section class="section contact" id="kontakt" aria-labelledby="kontakt-title">
  <div class="contact__glow" aria-hidden="true"></div>
  <div class="container contact__inner">
    <div class="contact__intro">
      <SectionHeading id="kontakt-title" eyebrow="Kontakt" title="Porozmawiajmy o Twoim projekcie">
        <p>
          Planujesz nową stronę internetową, aplikację albo odświeżenie istniejącego serwisu? Opisz
          krótko, czego potrzebujesz. Odpowiem z propozycją kolejnych kroków.
        </p>
      </SectionHeading>

      <ul role="list" class="channels" data-reveal>
        <li class="channel">
          <span class="channel__icon">
            <Icon name="map-pin" size={20} />
          </span>
          <div>
            <p class="channel__label">Lokalizacja</p>
            <p class="channel__value">
              {site.city}, {site.country}
            </p>
          </div>
        </li>
        {site.email && (
          <li class="channel">
            <span class="channel__icon">
              <Icon name="mail" size={20} />
            </span>
            <div>
              <p class="channel__label">E-mail</p>
              <a class="channel__value" href={`mailto:${site.email}`}>
                {site.email}
              </a>
            </div>
          </li>
        )}
        {site.discordUrl && (
          <li class="channel">
            <span class="channel__icon">
              <Icon name="discord" size={20} />
            </span>
            <div>
              <p class="channel__label">Discord</p>
              <a
                class="channel__value"
                href={site.discordUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Napisz wiadomość
                <span class="visually-hidden">(otwiera się w nowej karcie)</span>
              </a>
            </div>
          </li>
        )}
        {activeSocials.map((social) => (
          <li class="channel">
            <span class="channel__icon">
              <Icon name={social.icon} size={20} />
            </span>
            <div>
              <p class="channel__label">{social.label}</p>
              <a
                class="channel__value"
                href={social.url}
                target="_blank"
                rel="noopener noreferrer me"
              >
                Zobacz profil
                <span class="visually-hidden">(otwiera się w nowej karcie)</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="contact__form" data-reveal data-reveal-delay="1">
      <ContactForm />
    </div>
  </div>
</section>

<style>
  .contact {
    overflow: clip;
    isolation: isolate;
  }

  .contact__glow {
    position: absolute;
    right: -20%;
    bottom: -30%;
    z-index: -1;
    width: min(90vw, 760px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--glow-lime), transparent 62%);
    filter: blur(40px);
    pointer-events: none;
  }

  .contact__inner {
    display: grid;
    gap: 2.5rem;
  }

  .channels {
    display: grid;
    gap: 0.75rem;
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .channel__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    color: var(--accent);
  }

  .channel__label {
    color: var(--text-subtle);
    font-size: 0.8125rem;
  }

  .channel__value {
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  a.channel__value {
    text-decoration: none;
  }

  a.channel__value:hover {
    color: var(--accent);
  }

  @media (min-width: 64rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 5rem;
      align-items: start;
    }
  }
</style>
