---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { about } from '@/data/about';
---

<section class="section" id="o-mnie" aria-labelledby="o-mnie-title">
  <div class="container about">
    <div>
      <SectionHeading
        id="o-mnie-title"
        index="01"
        eyebrow="O mnie"
        title="Projektuję i programuję z myślą o ludziach."
      />
      <div class="about__text" data-reveal="up">
        {about.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>

    <ul role="list" class="principles">
      {about.principles.map((principle, index) => (
        <li class="principle" data-reveal="left" data-reveal-delay={index}>
          <span class="principle__icon">
            <Icon name={principle.icon} size={20} />
          </span>
          <div>
            <h3 class="principle__title">{principle.title}</h3>
            <p class="principle__text">{principle.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 3.5rem;
  }

  .about__text {
    display: grid;
    gap: 1.25rem;
    max-width: 38rem;
    color: var(--text-muted);
    font-size: 1.0625rem;
  }

  .about__text p:first-child {
    color: var(--ink);
    font-size: 1.1875rem;
  }

  .principles {
    border-top: 1px solid var(--line-strong);
  }

  .principle {
    display: flex;
    gap: 1.1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .principle__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out),
      transform 500ms var(--ease-out);
  }

  .principle:hover .principle__icon {
    background: var(--ink);
    color: var(--on-ink);
    transform: rotate(-15deg);
  }

  .principle__title {
    font-size: 1.125rem;
    letter-spacing: -0.015em;
  }

  .principle__text {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  @media (min-width: 64rem) {
    .about {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 5rem;
      align-items: end;
    }
  }
</style>
