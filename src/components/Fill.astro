---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

{value ? <Fragment set:text={value} /> : <mark class="fill">[do uzupełnienia: {label}]</mark>}

<style>
  .fill {
    padding: 0.05em 0.35em;
    border-radius: 4px;
    background: #f7e3bd;
    color: #7a4a00;
    font-weight: 500;
  }
</style>
