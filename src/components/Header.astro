---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { navigation } from '@/config/site';
---

<header class="header" data-header>
  <div class="header__inner container">
    <Logo />

    <nav class="nav" aria-label="Główna nawigacja">
      <ul role="list" class="nav__list">
        {navigation.map((item) => (
          <li>
            <a class="nav__link" href={item.href} data-nav-link>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--primary header__cta" href="/#kontakt">
      Porozmawiajmy
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="visually-hidden" data-menu-label>
        Otwórz menu
      </span>
      <span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="mobile-menu__nav container" aria-label="Menu mobilne">
      <ul role="list" class="mobile-menu__list">
        {navigation.map((item, index) => (
          <li class="mobile-menu__item" data-index={index}>
            <a class="mobile-menu__link" href={item.href} data-menu-link>
              <span class="mobile-menu__index" aria-hidden="true">
                0{index + 1}
              </span>
              {item.label}
              <Icon name="arrow-right" class="mobile-menu__arrow" size={20} />
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary mobile-menu__cta" href="/#kontakt" data-menu-link>
        Porozmawiajmy
        <Icon name="arrow-right" />
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header && toggle && label && menu) {
    const desktop = window.matchMedia('(min-width: 60rem)');
    let closeTimer: number | undefined;

    const setScrolled = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const open = () => {
      window.clearTimeout(closeTimer);
      menu.hidden = false;
      requestAnimationFrame(() => {
        header.classList.add('is-menu-open');
        document.body.classList.add('is-locked');
      });
      toggle.setAttribute('aria-expanded', 'true');
      label.textContent = 'Zamknij menu';
      document.dispatchEvent(new CustomEvent('menu:toggle', { detail: { open: true } }));
    };

    const close = (restoreFocus = false) => {
      if (!isOpen()) return;
      header.classList.remove('is-menu-open');
      document.body.classList.remove('is-locked');
      toggle.setAttribute('aria-expanded', 'false');
      label.textContent = 'Otwórz menu';
      const duration = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 500;
      closeTimer = window.setTimeout(() => (menu.hidden = true), duration);
      if (restoreFocus) toggle.focus();
      document.dispatchEvent(new CustomEvent('menu:toggle', { detail: { open: false } }));
    };

    toggle.addEventListener('click', () => (isOpen() ? close() : open()));

    menu.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => close());
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;
      if (event.key === 'Escape') {
        close(true);
        return;
      }
      if (event.key !== 'Tab') return;
      const focusable = [toggle, ...menu.querySelectorAll<HTMLElement>('a')];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    desktop.addEventListener('change', (event) => {
      if (event.matches) close();
    });

    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    const sections = [...links]
      .map((link) => document.getElementById(link.hash.slice(1)))
      .filter((section): section is HTMLElement => section !== null);

    if (sections.length > 0) {
      const visible = new Map<string, number>();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            visible.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
          }
          const [current] = [...visible.entries()].sort((a, b) => b[1] - a[1]);
          links.forEach((link) => {
            const active =
              current !== undefined && current[1] > 0 && link.hash === `#${current[0]}`;
            if (active) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        },
        { rootMargin: '-35% 0px -45% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
      );
      sections.forEach((section) => observer.observe(section));
    }
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-height);
  }

  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    opacity: 0;
    transition: opacity 300ms var(--ease-out);
  }

  .header.is-scrolled::before,
  .header.is-menu-open::before {
    opacity: 1;
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }

  .nav {
    display: none;
    margin-left: auto;
  }

  .nav__list {
    display: flex;
    gap: 0.25rem;
  }

  .nav__link {
    position: relative;
    display: block;
    padding: 0.5rem 0.85rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.2rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms var(--ease-out);
  }

  .nav__link:hover,
  .nav__link[aria-current] {
    color: var(--ink);
  }

  .nav__link:hover::after,
  .nav__link[aria-current]::after {
    transform: scaleX(1);
  }

  .header__cta {
    display: none;
    min-height: 2.5rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.875rem;
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 2.875rem;
    height: 2.875rem;
    margin-left: auto;
    margin-right: -0.5rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
  }

  .menu-toggle__bars,
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    display: block;
    width: 1.25rem;
    height: 1.5px;
    border-radius: 2px;
    background: var(--ink);
    transition:
      transform 320ms var(--ease-out),
      opacity 200ms var(--ease-out);
  }

  .menu-toggle__bars {
    position: relative;
    background: transparent;
  }

  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .menu-toggle__bars::before {
    transform: translateY(-4px);
  }

  .menu-toggle__bars::after {
    transform: translateY(4px);
  }

  .is-menu-open .menu-toggle__bars::before {
    transform: rotate(45deg);
  }

  .is-menu-open .menu-toggle__bars::after {
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-height) 0 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--bg);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 500ms var(--ease-in-out);
  }

  .is-menu-open .mobile-menu {
    clip-path: inset(0 0 0 0);
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block: 1.5rem calc(2rem + env(safe-area-inset-bottom));
  }

  .mobile-menu__item {
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 400ms var(--ease-out),
      transform 400ms var(--ease-out);
  }

  .is-menu-open .mobile-menu__item {
    opacity: 1;
    transform: none;
  }

  .is-menu-open .mobile-menu__item[data-index='1'] {
    transition-delay: 40ms;
  }
  .is-menu-open .mobile-menu__item[data-index='2'] {
    transition-delay: 80ms;
  }
  .is-menu-open .mobile-menu__item[data-index='3'] {
    transition-delay: 120ms;
  }
  .is-menu-open .mobile-menu__item[data-index='4'] {
    transition-delay: 160ms;
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .mobile-menu__index {
    color: var(--text-subtle);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }

  .mobile-menu__link :global(.mobile-menu__arrow) {
    margin-left: auto;
    color: var(--text-subtle);
    transition:
      transform var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out);
  }

  .mobile-menu__link:hover :global(.mobile-menu__arrow),
  .mobile-menu__link:focus-visible :global(.mobile-menu__arrow) {
    color: var(--accent-text);
    transform: translateX(4px);
  }

  .mobile-menu__cta {
    align-self: stretch;
  }

  @media (min-width: 60rem) {
    .nav,
    .header__cta {
      display: flex;
    }

    .header__cta {
      display: inline-flex;
    }

    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }
</style>
