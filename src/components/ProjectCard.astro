---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { projectStatuses } from '@/lib/project-status';
import type { Project } from '@/lib/projects';

interface Props {
  project: Project;
  headingLevel?: 'h3' | 'h2';
}

const { project, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = project;
const href = `/projekty/${project.id}/`;
---

<article class="project-card">
  <a class="project-card__media" href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={data.cover}
      alt=""
      widths={[480, 720, 960]}
      sizes="(min-width: 64rem) 560px, (min-width: 40rem) 50vw, 100vw"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="project-card__body">
    <div class="project-card__meta">
      <span>{data.category}</span>
      <span class="project-card__status" data-status={data.status}>
        {projectStatuses[data.status]}
      </span>
    </div>
    <Heading class="project-card__title">
      <a href={href}>{data.title}</a>
    </Heading>
    <p class="project-card__text">{data.description}</p>
    {data.technologies.length > 0 && (
      <ul role="list" class="project-card__tech" aria-label="Technologie">
        {data.technologies.map((tech) => (
          <li class="tag">{tech}</li>
        ))}
      </ul>
    )}
    <div class="project-card__links">
      <a class="project-card__more" href={href}>
        Szczegóły projektu
        <Icon name="arrow-right" size={18} />
      </a>
      {data.liveUrl && (
        <a href={data.liveUrl} target="_blank" rel="noopener noreferrer">
          Wersja online
          <Icon name="arrow-up-right" size={16} />
          <span class="visually-hidden">(otwiera się w nowej karcie)</span>
        </a>
      )}
      {data.repoUrl && (
        <a href={data.repoUrl} target="_blank" rel="noopener noreferrer">
          Kod źródłowy
          <Icon name="arrow-up-right" size={16} />
          <span class="visually-hidden">(otwiera się w nowej karcie)</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    transition:
      border-color 300ms var(--ease-out),
      transform 400ms var(--ease-out),
      box-shadow 400ms var(--ease-out);
  }

  .project-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-4px);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
  }

  .project-card__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .project-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .project-card:hover .project-card__media :global(img) {
    transform: scale(1.04);
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.6rem;
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--text-subtle);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project-card__status {
    color: var(--accent);
  }

  .project-card__status[data-status='concept'] {
    color: #9ed4ff;
  }

  .project-card__title {
    font-size: 1.5rem;
  }

  .project-card__title a {
    text-decoration: none;
  }

  .project-card__title a:hover {
    color: var(--accent);
  }

  .project-card__text {
    color: var(--text-muted);
  }

  .project-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .project-card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-block: 0.4rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .project-card__links a:hover {
    color: var(--text);
  }

  .project-card__links .project-card__more {
    color: var(--accent);
  }
</style>
