---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  align?: 'start' | 'center';
}

const { id, eyebrow, title, align = 'start' } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`]} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="section-heading__title">
    {title}
  </h2>
  {Astro.slots.has('default') && (
    <div class="section-heading__lead lead">
      <slot />
    </div>
  )}
</header>

<style>
  .section-heading {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .section-heading--center {
    justify-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .section-heading__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
  }

  .section-heading__lead :global(p + p) {
    margin-top: 1rem;
  }
</style>
