---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  index?: string;
}

const { id, eyebrow, title, index } = Astro.props;
---

<header class="section-heading">
  <p class="section-heading__meta" data-reveal="up">
    {index && <span class="section-heading__index">{index}</span>}
    <span class="eyebrow">{eyebrow}</span>
  </p>
  <h2 id={id} class="section-heading__title" data-reveal="clip">
    {title}
  </h2>
  {Astro.slots.has('default') && (
    <div class="section-heading__lead lead" data-reveal="up" data-reveal-delay="1">
      <slot />
    </div>
  )}
</header>

<style>
  .section-heading {
    display: grid;
    gap: 1.1rem;
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .section-heading__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .section-heading__index {
    color: var(--text-subtle);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .section-heading__title {
    font-size: clamp(2.1rem, 5.5vw, 3.75rem);
    letter-spacing: -0.04em;
  }

  .section-heading__lead :global(p + p) {
    margin-top: 1rem;
  }
</style>
