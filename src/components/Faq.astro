---
import SectionHeading from './SectionHeading.astro';
import { faq } from '@/data/faq';
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <SectionHeading id="faq-title" index="05" eyebrow="FAQ" title="Najczęstsze pytania" />

    <div class="faq__list">
      {faq.map((item, index) => (
        <details class="faq__item" open={index === 0} data-reveal="up" data-reveal-delay={index}>
          <summary class="faq__question">
            <h3>{item.question}</h3>
            <span class="faq__icon" aria-hidden="true" />
          </summary>
          <div class="faq__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
  }

  .faq__list {
    border-top: 1px solid var(--line-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--line-strong);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question h3 {
    font-size: clamp(1.0625rem, 2vw, 1.3125rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    transition: transform 400ms var(--ease-out);
  }

  .faq__question:hover h3 {
    transform: translateX(6px);
  }

  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color 300ms var(--ease-out),
      border-color 300ms var(--ease-out),
      transform 400ms var(--ease-out);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.75rem;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
    transition: transform 400ms var(--ease-out);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--ink);
    transform: rotate(180deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__answer {
    max-width: 44rem;
    padding: 0 3.5rem 1.6rem 0;
    color: var(--text-muted);
  }

  .faq__item[open] .faq__answer {
    animation: faq-open 500ms var(--ease-out);
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-8px);
      filter: blur(2px);
    }
  }

  @media (min-width: 64rem) {
    .faq {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4rem;
      align-items: start;
    }
  }
</style>
