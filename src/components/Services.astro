---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { services } from '@/data/services';
import { technologies } from '@/data/skills';
---

<section class="section section--alt" id="uslugi" aria-labelledby="uslugi-title">
  <div class="container">
    <SectionHeading id="uslugi-title" index="02" eyebrow="Usługi" title="W czym mogę pomóc">
      <p>
        Tworzenie stron internetowych w Poznaniu to dla mnie coś więcej niż kod. Łączę projektowanie
        interfejsów z programowaniem, więc strona wygląda tak, jak została zaprojektowana, i działa
        tak, jak powinna.
      </p>
    </SectionHeading>

    <ol role="list" class="services">
      {services.map((service, index) => (
        <li class="service" id={service.id} data-reveal="up">
          <span class="service__number">{String(index + 1).padStart(2, '0')}</span>
          <div class="service__main">
            <h3 class="service__title">{service.title}</h3>
            <p class="service__text">{service.description}</p>
          </div>
          <ul role="list" class="service__scope">
            {service.scope.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <span class="service__icon">
            <Icon name={service.icon} size={22} />
          </span>
        </li>
      ))}
    </ol>

    <div class="services__cta" data-reveal="scale">
      <p>
        <strong>Masz inny pomysł?</strong> Opisz, czego potrzebujesz. Wspólnie ustalimy, jakie
        rozwiązanie będzie najlepsze.
      </p>
      <a class="btn btn--primary" href="#kontakt" data-magnetic>
        Opisz projekt
        <Icon name="arrow-right" />
      </a>
    </div>

    {technologies.length > 0 && (
      <div class="tech" data-reveal="up">
        <h3 class="tech__title">Technologie i narzędzia</h3>
        <div class="tech__groups">
          {technologies.map((group) => (
            <div>
              <p class="tech__label">{group.group}</p>
              <ul role="list" class="tech__list">
                {group.items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .services {
    border-top: 1px solid var(--line-strong);
  }

  .service {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.75rem 1rem;
    padding: 1.75rem 0.25rem;
    isolation: isolate;
    border-bottom: 1px solid var(--line-strong);
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
    transition: color 400ms var(--ease-out);
  }

  .service::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--gutter));
    z-index: -1;
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 500ms var(--ease-in-out);
  }

  .service__number {
    padding-top: 0.35rem;
    color: var(--text-subtle);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .service__title {
    font-size: clamp(1.375rem, 3vw, 2rem);
    letter-spacing: -0.03em;
  }

  .service__text {
    max-width: 34rem;
    margin-top: 0.6rem;
    color: var(--text-muted);
  }

  .service__scope {
    display: flex;
    flex-wrap: wrap;
    grid-column: 2;
    gap: 0.4rem;
  }

  .service__scope li {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.8125rem;
  }

  .service__icon {
    display: none;
  }

  @media (hover: hover) {
    .service:hover {
      color: var(--on-ink);
    }

    .service:hover::before {
      transform: scaleY(1);
    }

    .service:hover .service__text,
    .service:hover .service__number {
      color: rgb(243 241 236 / 0.72);
    }

    .service:hover .service__scope li {
      border-color: rgb(243 241 236 / 0.3);
    }

    .service:hover .service__icon {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--ink);
      transform: rotate(-45deg) scale(1.08);
    }
  }

  .service__text,
  .service__number,
  .service__scope li {
    transition:
      color 400ms var(--ease-out),
      border-color 400ms var(--ease-out);
  }

  .services__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: 3rem;
    padding: 1.75rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
  }

  .services__cta p {
    max-width: 36rem;
    color: var(--text-muted);
  }

  .services__cta strong {
    color: var(--ink);
  }

  .tech {
    margin-top: 4rem;
  }

  .tech__title {
    font-size: 1.25rem;
  }

  .tech__groups {
    display: grid;
    gap: 1.75rem;
    margin-top: 1.5rem;
  }

  .tech__label {
    margin-bottom: 0.75rem;
    color: var(--text-subtle);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tech__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (min-width: 56rem) {
    .service {
      grid-template-columns: 3.5rem minmax(0, 1.2fr) minmax(0, 1fr) 3rem;
      align-items: center;
      gap: 2rem;
      padding-block: 2.25rem;
    }

    .service__scope {
      grid-column: auto;
    }

    .service__icon {
      display: grid;
      place-items: center;
      justify-self: end;
      width: 3rem;
      height: 3rem;
      border: 1px solid var(--line-strong);
      border-radius: 50%;
      transition:
        background-color 400ms var(--ease-out),
        border-color 400ms var(--ease-out),
        color 400ms var(--ease-out),
        transform 500ms var(--ease-out);
    }

    .tech__groups {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }
</style>
