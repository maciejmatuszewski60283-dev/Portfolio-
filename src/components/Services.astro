---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { services } from '@/data/services';
import { technologies } from '@/data/skills';
---

<section class="section" id="uslugi" aria-labelledby="uslugi-title">
  <div class="container">
    <SectionHeading id="uslugi-title" eyebrow="Usługi" title="W czym mogę pomóc">
      <p>
        Tworzenie stron internetowych w Poznaniu to dla mnie coś więcej niż kod. Łączę projektowanie
        interfejsów z programowaniem, dzięki czemu strona wygląda dokładnie tak, jak została
        zaprojektowana — i działa tak, jak powinna.
      </p>
    </SectionHeading>

    <ul role="list" class="services">
      {services.map((service, index) => (
        <li class="service" id={service.id} data-reveal data-reveal-delay={index % 3}>
          <span class="service__icon">
            <Icon name={service.icon} size={24} />
          </span>
          <h3 class="service__title">{service.title}</h3>
          <p class="service__text">{service.description}</p>
          <ul role="list" class="service__scope">
            {service.scope.map((item) => (
              <li>
                <Icon name="check" size={16} />
                {item}
              </li>
            ))}
          </ul>
        </li>
      ))}
      <li class="service service--cta" data-reveal data-reveal-delay="2">
        <h3 class="service__title">Masz inny pomysł?</h3>
        <p class="service__text">
          Opisz, czego potrzebujesz — wspólnie ustalimy, jakie rozwiązanie będzie najlepsze.
        </p>
        <a class="btn btn--primary" href="#kontakt">
          Opisz projekt
          <Icon name="arrow-right" />
        </a>
      </li>
    </ul>

    {technologies.length > 0 && (
      <div class="tech" data-reveal>
        <h3 class="tech__title">Technologie i narzędzia</h3>
        <div class="tech__groups">
          {technologies.map((group) => (
            <div class="tech__group">
              <p class="tech__label">{group.group}</p>
              <ul role="list" class="tech__list">
                {group.items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .services {
    display: grid;
    gap: 1rem;
  }

  .service {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.03), rgb(255 255 255 / 0.01));
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
    transition:
      border-color 300ms var(--ease-out),
      transform 300ms var(--ease-out),
      background-color 300ms var(--ease-out);
  }

  .service::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 80% at 0% 0%, rgb(201 242 122 / 0.08), transparent 55%);
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
    pointer-events: none;
  }

  .service:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }

  .service:hover::before,
  .service:target::before {
    opacity: 1;
  }

  .service:target {
    border-color: rgb(201 242 122 / 0.4);
  }

  .service__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    background: var(--surface-strong);
    color: var(--accent);
  }

  .service__title {
    font-size: 1.3125rem;
    letter-spacing: -0.02em;
  }

  .service__text {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 0.9688rem;
  }

  .service__scope {
    display: grid;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 0.9063rem;
  }

  .service__scope li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .service__scope :global(svg) {
    flex-shrink: 0;
    color: var(--accent);
  }

  .service--cta {
    justify-content: center;
    gap: 0;
    border-style: dashed;
    border-color: rgb(201 242 122 / 0.28);
    background: var(--accent-soft);
  }

  .service--cta .btn {
    align-self: flex-start;
    margin-top: 1.5rem;
  }

  .tech {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .tech__title {
    font-size: 1.25rem;
  }

  .tech__groups {
    display: grid;
    gap: 1.75rem;
    margin-top: 1.75rem;
  }

  .tech__label {
    margin-bottom: 0.75rem;
    color: var(--text-subtle);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tech__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (min-width: 40rem) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tech__groups {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .services {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
